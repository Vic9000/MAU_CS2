<Window x:Class="Assignment4.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Control Tower Simulator" Height="450" Width="600">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,10,0">
            <TextBlock Text="Registered Flights" FontWeight="Bold"/>
            <ListBox x:Name="lstFlights" Height="300" Margin="0,5,0,5"/>
            <Button Content="Authorize Take Off" Click="BtnTakeOff_Click" Height="30"/>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Status Log" FontWeight="Bold"/>
            <ListBox x:Name="lstLog" Height="335" Margin="0,5,0,0"/>
        </StackPanel>
    </Grid>
</Window>