<Window x:Class="Assignment5.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Assignment5"
        mc:Ignorable="d"
        Title="MainWindow" Height="400" Width="500">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0">
            <StackPanel Orientation="Vertical">
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0">Total Income</Label>
                    <Label x:Name="lblTotalIncome" Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0"></Label>
                </Grid>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0">Total Expenses</Label>
                    <Label x:Name="lblTotalExpense" Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0"></Label>
                </Grid>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*"/>
                        <ColumnDefinition Width="1*"/>
                    </Grid.ColumnDefinitions>

                    <Label Grid.Column="0">Net Cash-Flow</Label>
                    <Label x:Name="lblCashFlow" Grid.Column="1" BorderBrush="Black" BorderThickness="1" Margin="0,0,5,0"></Label>
                </Grid>
            </StackPanel>
            <ListBox x:Name="lstTransactions" Margin="5" Height="200">

            </ListBox>
        </StackPanel>
        
        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Vertical">
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0">Transaction Date</Label>
                <DatePicker x:Name="dpDate" Grid.Column="1"></DatePicker>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0">Type of Transaction</Label>
                <ComboBox x:Name="cmbCategoryType" Grid.Column="1"></ComboBox>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0">Amount</Label>
                <TextBox x:Name="txtAmount" Grid.Column="1"></TextBox>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0">Description</Label>
                <TextBox x:Name="txtDescription" Grid.Column="1"></TextBox>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0">Category</Label>
                <TextBox x:Name="txtCategory" Grid.Column="1"></TextBox>
            </Grid>
            <StackPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,10">
                <Button x:Name="Add" Width="100" Height="25">Add Expense</Button>
                
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
